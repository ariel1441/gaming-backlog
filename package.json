{
  "name": "game-backlog-app",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "start": "node backend/index.js",
    "dev:ports": "node scripts/free-dev-ports.js",
    "dev:ports:back": "node scripts/free-dev-ports.js --ports=5000",
    "dev:ports:back:dry": "node scripts/free-dev-ports.js --ports=5000 --dry-run",
    "dev:ports:front": "node scripts/free-dev-ports.js --ports=5173",
    "dev:ports:front:dry": "node scripts/free-dev-ports.js --ports=5173 --dry-run",
    "dev:ports:dry": "node scripts/free-dev-ports.js --dry-run",
    "dev": "node scripts/dev.js",
    "dev:back": "cross-env NODE_ENV=development nodemon --delay 2500ms --signal SIGINT --watch backend --watch .env --ignore backend/data/** --ignore backend/node_modules/** --ignore backend/**/*.test.js --ignore backend/migrations/** --ignore backend/schema.sql --ext js,env backend/index.js",
    "dev:front": "cross-env NODE_ENV=development vite --host localhost --port 5173 --strictPort",
    "serve": "node backend/index.js",
    "build": "vite build && node scripts/check-bundle-budget.js",
    "check:bundle": "node scripts/check-bundle-budget.js",
    "preview": "cross-env NODE_ENV=production vite preview --port 5173",
    "lint": "eslint --rulesdir scripts/eslint-rules .",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm test && npm run build",
    "env:check": "node scripts/check-env.js",
    "db:migrate:local": "node scripts/db-migrate.js",
    "db:migrate:status": "node scripts/db-migrate.js --status",
    "db:migrate:prod": "node scripts/db-migrate.js --production --confirm-production",
    "db:migrate:prod:status": "node scripts/db-migrate.js --production --confirm-production --status",
    "catalog:seed": "node scripts/seed-catalog-collections.js",
    "metadata:import-cache": "node scripts/import-rawg-cache.js",
    "metadata:import-cache:local": "node scripts/import-rawg-cache.js --apply",
    "metadata:repair-exact": "node scripts/repair-exact-metadata-links.js",
    "metadata:repair-exact:local": "node scripts/repair-exact-metadata-links.js --apply",
    "db:copy-prod-to-local": "node scripts/copy-prod-to-local.js --confirm-local-overwrite",
    "db:reset:local": "node scripts/reset-local-db.js",
    "test:smoke": "playwright test tests/e2e/routes.smoke.spec.js",
    "check:full": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@heroicons/react": "^2.2.0",
    "@vercel/analytics": "^1.5.0",
    "bcrypt": "^6.0.0",
    "celebrate": "^15.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "howlongtobeat": "^1.8.0",
    "isomorphic-dompurify": "^2.26.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.539.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.8.0",
    "react-select": "^5.10.1",
    "recharts": "^3.1.2",
    "string-similarity": "^4.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "eslint": "^8.57.1",
    "nodemon": "^3.0.3",
    "postcss": "^8.5.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5"
  }
}
