NODE_ENV=development
RAWG_API_KEY=your_rawg_api_key
PORT=5000
DATABASE_URL=postgres://postgres:password@localhost:5432/gaming_backlog_local
# Optional discrete connection fields when DATABASE_URL is intentionally unset:
DB_USER=
DB_HOST=localhost
DB_NAME=
DB_PASSWORD=
DB_PORT=5432
PGSSL=false
PGSSL_CA=
PGSSL_CA_FILE=
# Development-only escape hatch; rejected in production.
PGSSL_ALLOW_UNVERIFIED_DEV=false
JWT_SECRET=your_local_jwt_secret
VITE_API_BASE_URL=http://localhost:5000
VITE_PORT=5173
VITE_FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGIN_SUFFIXES=
MICROCACHE_TTL_MS=300000
MICROCACHE_MAX_KEYS=500
RAWG_FAIL_TTL_MS=3600000
RAWG_TIMEOUT_MS=10000
RAWG_MAX_RESPONSE_BYTES=2097152
RAWG_CACHE_MAX_ENTRIES=1000
PUBLIC_RAWG_CONCURRENCY=3
PUBLIC_RAWG_HYDRATE_LIMIT=24
HLTB_DATA_PATH=
HLTB_UNITS=seconds
DEMO_ENABLED=true
DEMO_TEMPLATE_USERNAME=demo_template
DEMO_GUEST_TTL_HOURS=36
CATALOG_AUTO_SEED=false
CATALOG_SEED_LIMIT=24
STEAM_WEB_API_KEY=
STEAM_OPENID_REALM=http://localhost:5000
STEAM_OPENID_RETURN_URL=http://localhost:5000/api/steam/auth/callback
STEAM_FRONTEND_RETURN_URL=http://localhost:5173
STEAM_MOCK_OWNED_GAMES_JSON=
STEAM_MOCK_PLAYER_SUMMARY_JSON=
STEAM_DEV_SYNC_SAMPLE=false
STEAM_TIMEOUT_MS=10000
STEAM_MAX_RESPONSE_BYTES=5242880
STEAM_SYNC_CHUNK_SIZE=20

# Guardrail: leave unset/false for normal work.
# Set true only for a deliberate one-off task that must connect dev code to a remote DB.
ALLOW_REMOTE_DB_IN_DEV=false
# One-shot script confirmations; normally leave false/unset.
CONFIRM_LOCAL_DB_OVERWRITE=false
CONFIRM_PROD_MIGRATIONS=false
